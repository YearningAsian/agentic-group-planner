# Web app environment. Copy to web/.env.local and fill in the blanks.
# Placeholders only: never put real keys or real phone numbers in this file.
# This is the build profile: dev mode, and every provider on its mock except Supabase.
# The server validates everything at boot and lists every missing or invalid variable.

# --- App and Supabase ----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local stack: `pnpm exec supabase start`, then copy API_URL, PUBLISHABLE_KEY, and SECRET_KEY
# from `pnpm exec supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the admin client and the seed scripts.
SUPABASE_SECRET_KEY=

# --- Dev mode ------------------------------------------------------------------------------
# true: seeded-user login picker, dev toolbar, /api/demo/*. Never true in production.
NEXT_PUBLIC_DEMO_MODE=true
# The x-demo-token value for /api/demo/*. Required in dev mode.
DEMO_ADMIN_TOKEN=change-me-dev-admin-token

# --- Agent (Meta Model API) ----------------------------------------------------------------
# meta (default) | google | mock. mock replays recorded runs from web/scripts/demo/fixtures/agent-recordings.
LLM_PROVIDER=mock
# Defaults to a Meta model ID. With LLM_PROVIDER=google, set a Gemini model ID.
AGENT_MODEL=muse-spark-1.3
# 1 records real runs to fixtures.
AGENT_RECORD=0
# Required when LLM_PROVIDER=meta or TRANSCRIBE_PROVIDER=real.
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
# Required when LLM_PROVIDER=google (the fallback).
GOOGLE_GENERATIVE_AI_API_KEY=

# Voice notes in the trip chat (16 kHz mono WAV, converted in the browser): real | mock (default mock).
TRANSCRIBE_PROVIDER=mock
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# --- Optimizer (FastAPI) -------------------------------------------------------------------
OPTIMIZER_URL=http://localhost:8000
# The same value as OPTIMIZER_TOKEN in optimizer/.env.
OPTIMIZER_TOKEN=change-me-local-optimizer-token

# --- Payments (Stripe test mode only) ------------------------------------------------------
# real | mock
PAYMENTS_PROVIDER=mock
# Required when real. Test keys only (sk_test_); a live key fails the boot.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Places, routing, and stays ------------------------------------------------------------
# real | mock
PLACES_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
ROUTING_PROVIDER=mock
ORS_API_KEY=
STAYS_PROVIDER=mock
# Test token only (duffel_test_).
DUFFEL_ACCESS_TOKEN=

# --- Scheduled jobs ------------------------------------------------------------------------
# Vercel cron sends it as a bearer token (web/vercel.json). At least 16 characters; required when
# VERCEL_ENV=production. Unset, the cron routes refuse every call.
CRON_SECRET=

# --- Monitoring (optional) -----------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Seed scripts (web/scripts/demo) -------------------------------------------------------
# Salts Person 4's stable invite token (seeded users have no passwords; they sign in by magic link).
DEMO_SEED_SECRET=change-me-seed-secret
DEMO_EMAIL_DOMAIN=demo.agp.test
