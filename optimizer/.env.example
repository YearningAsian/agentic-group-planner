# Optimizer settings. Copy to optimizer/.env for local runs (`uvicorn app.main:app --env-file .env`).
# Placeholders only: never put real values in this file.

# Bearer token; the same value as OPTIMIZER_TOKEN in web/.env.local.
OPTIMIZER_TOKEN=change-me-local-optimizer-token
# Vultr (Docker) sets PORT; locally, pass --port to uvicorn.
PORT=8000
# Optional
SOLVER_TIME_LIMIT_MS=2000
SENTRY_DSN=
LOG_LEVEL=info
