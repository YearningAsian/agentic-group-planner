# Public Mapbox token (starts with pk.).
# This value is a dummy. Replace it to load live tiles on the onboarding map.
# Without a real token, the questionnaire still pans a preview map and drops a pin.
#
# Run from this folder:
#   pnpm install --ignore-workspace
#   pnpm dev
# Then open http://localhost:3001
NEXT_PUBLIC_MAPBOX_TOKEN=pk.placeholder.dummy-token-replace-me
